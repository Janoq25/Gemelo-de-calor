# Token de la API de EPHT. Sin el, la API devuelve 429 tras ~8 peticiones.
# Solicitar a trackingsupport@cdc.gov (checklist §19 del plan).
XDT_EPHT_TOKEN=

# Header User-Agent identificativo. Obligatorio para api.weather.gov (NWS).
XDT_USER_AGENT="xai-dt-heat/0.1 (tesis; tu-correo@universidad.edu)"

# Raiz de datos. Por defecto <repo>/data
# XDT_DATA_ROOT=
